# --- Required -------------------------------------------------------------
# Token from @BotFather (create a bot there with /newbot)
BOT_TOKEN=<redacted>

# Public address where this bot's web server can be reached.
# This is what download links start with, e.g.:
#   http://203.0.113.10:8080        (a VPS, port opened)
#   https://files.example.com       (a domain behind a reverse proxy)
#   http://nodeXX.danbot.host:PORT  (DanBot/Pterodactyl: your allocated port)
# No trailing slash.
BASE_URL=http://YOUR_SERVER_IP:8080

# --- Owners & access --------------------------------------------------------
# Comma-separated Telegram IDs of the bot's owners. Owners are always
# allowed to use the bot and are the ONLY ones who can open the /admin
# menu to add/remove allowed users from inside Telegram.
# Get your own ID from @userinfobot. Example: OWNER_IDS=123456789
OWNER_IDS=

# Comma-separated Telegram user IDs allowed to use the bot — a one-time
# seed. The live list is stored in SQLite and managed from the /admin
# menu (or /adduser, /removeuser, /users); use this only for first boot.
# Empty list + no owners = everyone who finds the bot can use it.
ALLOWED_USER_IDS=

# --- Local Bot API server (optional — raises Telegram limits to 2 GB) -----
# Address of a running telegram-bot-api server, e.g. http://127.0.0.1:8081
# Empty = use the public api.telegram.org (20 MB in / 50 MB out).
BOT_API_URL=

# Set to 1 only when the bot and the telegram-bot-api server share a
# filesystem (same machine/container): downloads become local file copies.
BOT_API_LOCAL_MODE=0

# Only for start.sh (DanBot/Pterodactyl): if a telegram-bot-api binary is
# placed at bin/telegram-bot-api, start.sh launches it automatically using
# these credentials (get them at https://my.telegram.org -> API development).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
BOT_API_PORT=8081
BOT_API_AUTOSTART=1

# --- Optional ---------------------------------------------------------------
HOST=0.0.0.0
# Web server port. On Pterodactyl/DanBot leave this unset — the panel's
# allocated port is injected as SERVER_PORT and used automatically.
PORT=8080

# Where downloaded/uploaded files are stored
STORAGE_DIR=./storage

# Refuse URL downloads larger than this (MB)
MAX_URL_DOWNLOAD_MB=2048

# Automatically delete stored files after this many hours. 0 = keep forever
FILE_TTL_HOURS=0
